# =============================================================================
# Datasets and run outputs
#
# NOTE: the benchmark repos (ResViT/, CyTran/, SynDiff/, CFPS-Diff/) are now
# vendored as plain directories, so every pattern here reaches inside them. A
# bare `data/` or `datasets/` would swallow ResViT/data/aligned_dataset.py,
# CyTran/data/vindr_dataset.py and friends. Anchor them, and ignore only the
# prepped-slice output that prep_benchmark_data.py writes.
# =============================================================================
/data/
/pars_CT/
/test_dataset_output/
/batch*
*/datasets/vindr/
*/datasets/vindr_*/
checkpoints/
results/
runs/
outputs/
samples/
wandb/
*.log

# =============================================================================
# Editor / OS
# =============================================================================
.DS_Store
.vscode/
.idea/



